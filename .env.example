# ── Wallet ────────────────────────────────────────────────────────────────────
# Your deployer private key (prefixed with 0x) 
PRIVATE_KEY=0xyour_private_key_here

# Your deployer address (must match the key above)
DEPLOYER_ADDRESS=0xyour_deployer_address_here

# ── Somnia Network ────────────────────────────────────────────────────────────
SOMNIA_TESTNET_RPC=https://dream-rpc.somnia.network

# ── Somnia Agent Platform ─────────────────────────────────────────────────────
# Testnet platform contract — do not change, this is the official Somnia address
PLATFORM_ADDRESS=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776

# LLM Inference Agent ID — get from https://agents.testnet.somnia.network
# Find "LLM Inference" agent, click it, copy the numeric ID
LLM_AGENT_ID=your_llm_agent_id_here

# Explorer API key (optional — only needed for --verify flag on forge script)
ETHERSCAN_API_KEY=

# ── Deployed contract addresses ───────────────────────────────────────────────
# Leave blank before first deploy. Fill in after running DeployAndSubmit.s.sol.
CURATED_VAULT_ADDRESS=
VAULT_SENTINEL_ADDRESS=
MOCK_USDC_ADDRESS=
MARKET_A_ADDRESS=
MARKET_B_ADDRESS=
