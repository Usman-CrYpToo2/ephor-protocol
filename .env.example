# ── Wallet ────────────────────────────────────────────────────────────────────
# Your deployer private key (prefixed with 0x)
PRIVATE_KEY=0xyour_private_key_here

# Your deployer address (must match the key above)
DEPLOYER_ADDRESS=0xyour_deployer_address_here

# ── Somnia Network ────────────────────────────────────────────────────────────
SOMNIA_TESTNET_RPC=https://dream-rpc.somnia.network

# ── Somnia Agent Platform ─────────────────────────────────────────────────────
# Testnet platform contract — do not change
PLATFORM_ADDRESS=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776

# LLM Inference Agent ID — get from https://agents.testnet.somnia.network
# Click "LLM Inference" agent, copy the numeric ID
LLM_AGENT_ID=your_llm_agent_id_here

# Explorer API key (optional — only for --verify flag)
ETHERSCAN_API_KEY=

# ── Shared infrastructure ─────────────────────────────────────────────────────
# Filled in after running DeployAndSubmit.s.sol
VAULT_SENTINEL_ADDRESS=
ORACLE_ADDRESS=

# ── USDC Vault ────────────────────────────────────────────────────────────────
MOCK_USDC_ADDRESS=
USDC_VAULT_ADDRESS=
USDC_MARKET_A_ADDRESS=
USDC_MARKET_B_ADDRESS=
USDC_STRATEGIST_ADDRESS=

# ── WETH Vault ────────────────────────────────────────────────────────────────
MOCK_WETH_ADDRESS=
WETH_VAULT_ADDRESS=
WETH_MARKET_A_ADDRESS=
WETH_MARKET_B_ADDRESS=
WETH_STRATEGIST_ADDRESS=

# ── WBTC Vault ────────────────────────────────────────────────────────────────
MOCK_WBTC_ADDRESS=
WBTC_VAULT_ADDRESS=
WBTC_MARKET_A_ADDRESS=
WBTC_MARKET_B_ADDRESS=
WBTC_STRATEGIST_ADDRESS=
